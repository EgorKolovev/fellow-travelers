# Скопируйте в .env и заполните. Реальные секреты не коммитить.

# Строка подключения к PostgreSQL (драйвер asyncpg).
# В docker compose переопределяется на хост `db`.
DATABASE_URL=postgresql+asyncpg://fellow:fellow@localhost:5434/fellow_travelers

# БД для тестов (по умолчанию как ниже; тесты создают её сами).
# TEST_DATABASE_URL=postgresql+asyncpg://fellow:fellow@localhost:5434/fellow_travelers_test

# Токен Telegram-бота (от @BotFather); используется для проверки initData.
BOT_TOKEN=change-me

# Username бота без @.
BOT_USERNAME=your_bot

# Необязательный Cloudflare relay. Обе переменные задаются вместе.
# TELEGRAM_RELAY_URL=https://fellow-telegram-relay.maxsk-09.workers.dev
# TELEGRAM_RELAY_SECRET=тот_же_секрет_что_RELAY_SHARED_SECRET_в_Worker

# Максимальный возраст initData, секунды (по умолчанию сутки).
# Для разработки в браузере (python -m app.dev.users) удобно 604800 (неделя).
INIT_DATA_MAX_AGE_SECONDS=86400

# Режим отладки (true/false).
DEBUG=false

# Уровень логов: DEBUG, INFO, WARNING, ERROR. Логи — JSON в stdout.
LOG_LEVEL=INFO

# Порт метрик воркера фоновых заданий (Prometheus, GET /metrics). Наружу не публикуется.
WORKER_METRICS_PORT=9100

# Адрес мини-приложения (https). Если задан, бот после получения контакта включает
# в чате кнопку меню «Открыть приложение». Можно голым доменом (https:// допишется).
# WEB_APP_URL=https://<домен мини-приложения>

# Поставщик рейсов: none (поиск отвечает 503), fake (тестовый, в памяти) или aerodatabox
# FLIGHT_PROVIDER=none
# AERODATABOX_API_KEY=ключ_AeroDataBox
# AERODATABOX_GATEWAY=apimarket   # apimarket | direct | rapidapi

# Удаление данных групп через 7 суток после окончания (необратимо)
# RETENTION_ENABLED=false
